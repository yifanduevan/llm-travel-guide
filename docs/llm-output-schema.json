{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trip Planner LLM Output Schemas",
  "description": "JSON schemas for LLM responses. Must match backend DTOs and enums.",
  "definitions": {
    "travelers": {
      "type": "string",
      "enum": ["solo", "couple", "family", "group"]
    },
    "budget": {
      "type": "string",
      "enum": ["budget", "medium", "luxury"]
    },
    "transportType": {
      "type": "string",
      "enum": ["flight", "train", "car", "bus", "other"]
    },
    "itineraryItemCategory": {
      "type": "string",
      "enum": ["unspecified"]
    },
    "itineraryItem": {
      "type": "object",
      "required": ["title", "category"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "time": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$" },
        "category": { "$ref": "#/definitions/itineraryItemCategory" },
        "locationText": { "type": "string" },
        "linkUrl": { "type": "string", "format": "uri" }
      }
    },
    "itineraryDay": {
      "type": "object",
      "required": ["date", "items"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/itineraryItem" }
        }
      }
    },
    "restaurant": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "cuisine": { "type": "string" },
        "priceTier": { "$ref": "#/definitions/budget" },
        "suggestedTime": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$" },
        "address": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "activity": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "durationMinutes": { "type": "integer", "minimum": 0 },
        "category": { "type": "string" },
        "locationText": { "type": "string" },
        "linkUrl": { "type": "string", "format": "uri" }
      }
    },
    "transportSegment": {
      "type": "object",
      "required": ["type", "title"],
      "properties": {
        "type": { "$ref": "#/definitions/transportType" },
        "title": { "type": "string" },
        "startLocation": { "type": "string" },
        "endLocation": { "type": "string" },
        "startTime": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$" },
        "endTime": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$" },
        "durationText": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "packingItem": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1, "default": 1 },
        "optional": { "type": "boolean", "default": false }
      }
    }
  },
  "oneOf": [
    {
      "title": "ItineraryResponse",
      "type": "object",
      "required": ["days"],
      "properties": {
        "days": {
          "type": "array",
          "items": { "$ref": "#/definitions/itineraryDay" }
        }
      }
    },
    {
      "title": "DiningResponse",
      "type": "object",
      "required": ["restaurants"],
      "properties": {
        "restaurants": {
          "type": "array",
          "items": { "$ref": "#/definitions/restaurant" }
        }
      }
    },
    {
      "title": "ActivitiesResponse",
      "type": "object",
      "required": ["activities"],
      "properties": {
        "activities": {
          "type": "array",
          "items": { "$ref": "#/definitions/activity" }
        }
      }
    },
    {
      "title": "TransportResponse",
      "type": "object",
      "required": ["segments"],
      "properties": {
        "segments": {
          "type": "array",
          "items": { "$ref": "#/definitions/transportSegment" }
        }
      }
    },
    {
      "title": "PackingListResponse",
      "type": "object",
      "required": ["categories"],
      "properties": {
        "categories": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/definitions/packingItem" }
          }
        }
      }
    }
  ]
}
