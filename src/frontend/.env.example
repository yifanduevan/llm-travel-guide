# Frontend mode
# Set to false to call real backend + AI itinerary proxy route.
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_ALLOW_MOCK=false

# AI itinerary proxy config (server-only)
# Used by src/frontend/app/api/ai/itinerary/route.ts
LLM_SERVICE_URL=https://your-llm-service.example.com/itinerary
LLM_SERVICE_TOKEN=replace-with-llm-service-token

# Optional frontend API base URL override
# Defaults to http://localhost:8080 if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
